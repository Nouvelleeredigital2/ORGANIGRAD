# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.worktrees/
dist
dist-ssr
*.local

# Env (les valeurs runtime ne sont jamais commitées)
.env
.env.*
!.env.example
!.env.test

