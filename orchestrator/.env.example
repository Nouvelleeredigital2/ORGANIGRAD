# ─── Orchestrateur Organigrad — template variables d'environnement ───────────
# Copier en .env (ou .env.production / .env.vps selon la cible) puis remplir.
# ⚠️  Ne JAMAIS committer un fichier rempli : tout fichier .env* (sauf .example
#     et .test) est ignoré par .gitignore.

# ── Mode de fonctionnement ───────────────────────────────────────────────────
# Si SUPABASE_DB_URL est défini → mode Postgres + auth par clé API (production).
# Sans SUPABASE_DB_URL, le démarrage ÉCHOUE, sauf opt-in explicite du mode
# in-memory (dev local / tests, SANS authentification) :
# ORCHESTRATOR_ALLOW_MEMORY=1

# Port d'écoute HTTP (défaut : 3001)
PORT=3001

# Projets persistants (pilote) : activer seulement après migration qualifiée et
# vérification des sessions humaines. Coordonner avec VITE_PROJECTS_ENABLED.
PROJECTS_ENABLED=false

# ── Livraison Orvion sous reçu (circuits) ────────────────────────────────────
# Désactivée par défaut. Exige CIRCUITS_ENABLED=true et
# PROJECT_SERVICE_DELEGATIONS_ENABLED=true (eux-mêmes derrière PROJECTS_ENABLED),
# APP_URL en HTTPS (envoyé comme en-tête Origin à Orvion) et la migration
# 20260915120000_circuit_execution_receipts appliquée sur la base cible.
CIRCUIT_DELIVERY_ENABLED=false
# Origine HTTPS nue d'Atelier Orvion (sans chemin) et sa copie qualifiée au
# déploiement : les deux doivent être identiques, sinon le démarrage échoue.
ORVION_BASE_URL=https://orvion.example.com/
ORVION_QUALIFIED_ORIGIN=https://orvion.example.com
# ⚠️  SECRET — chemin d'un fichier (hors dépôt, droits 600) contenant l'UUID du
# mandat de service Orvion. Lu au démarrage ; jamais journalisé, jamais en variable.
ORVION_SERVICE_MANDATE_FILE=/run/secrets/orvion-service-mandate
# ── Génération d'images (étape « generation », recette Atelier Boréal) ──────
# Désactivée par défaut. Exige CIRCUIT_DELIVERY_ENABLED=true et la migration
# 20260911165000_circuit_attempts (tentative durable AVANT l'unique POST). Engine
# indisponible → l'exécution passe en waiting_engine, jamais une image de remplacement.
ENGINE_GENERATION_ENABLED=false
# Origine HTTPS nue de ned-media-engine et sa copie qualifiée au déploiement.
ENGINE_BASE_URL=https://engine.example.com/
ENGINE_QUALIFIED_ORIGIN=https://engine.example.com
# ⚠️  SECRET — fichier (hors dépôt, droits 600) contenant la clé API Engine.
ENGINE_API_KEY_FILE=/run/secrets/engine-api-key
# Moteur explicite (jamais « automatic ») : flux-main dans le MVP.
ENGINE_ID=flux-main

# ── Base de données Postgres (Supabase) ──────────────────────────────────────
# Connection string Postgres avec le rôle service_role.
# Format : postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require
# ⚠️  SECRET — donne un accès total à la base. À stocker hors dépôt et à
#     renouveler si jamais exposé.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── Edge Function e-mail (Supabase) ──────────────────────────────────────────
# URL de la fonction notify-email déployée.
EMAIL_EDGE_FUNCTION_URL=https://<project-ref>.functions.supabase.co/notify-email

# Clé service_role utilisée pour appeler l'Edge Function.
# ⚠️  SECRET — à ne jamais exposer côté client ni journaliser.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Secret JWT du projet Supabase (HS256, projets « legacy ») — vérifie les
# sessions utilisateur pour la validation humaine (approve/reject). ⚠️ SECRET.
# Dashboard Supabase → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET

# URL JWKS du projet Supabase — REQUISE pour les projets migrés vers les
# « JWT signing keys » : leurs jetons de session sont signés ES256 et le
# secret HS256 ci-dessus ne peut PAS les vérifier. Pas un secret (clés
# publiques). Le projet xucmfdggetwxmpquqjvj est dans ce cas.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Pont LINK (import des bots Hermes/LINK comme nœuds AGENT_IA) ────────────
# Optionnel : absent → POST /api/integrations/link/import répond 503.
LINK_BASE_URL=https://link.nouvelleeredigital.fr
# Doit correspondre à ORGANIGRAD_BRIDGE_TOKEN côté LINK. ⚠️ SECRET.
# Générer : `openssl rand -base64 32`.
LINK_BRIDGE_TOKEN=REPLACE_WITH_LINK_BRIDGE_TOKEN

# ── Pont LINK ↔ hub Synapse (décisions relayées par acteur signé) ──────────
# Recette « Atelier Boréal ». 0 (défaut) = routes /api/link-bridge/* et
# /api/identity-links/* en 404. 1 = les quatre variables suivantes sont
# OBLIGATOIRES (le démarrage échoue sinon), plus APP_URL https et une
# vérification de session (SUPABASE_JWT_SECRET ou SUPABASE_JWKS_URL).
LINK_BRIDGE_ENABLED=0
# Fichier JSON {"<kid>": "-----BEGIN PUBLIC KEY-----..."} : clés publiques
# Ed25519 ÉPINGLÉES du hub Synapse (pas un secret, mais à protéger en écriture).
LINK_BRIDGE_HUB_PUBLIC_KEYS_FILE=/run/secrets/synapse-hub-public-keys.json
# kid annoncé dans les attestations OrganiGrad (doit être connu du hub).
ORGANIGRAD_IDENTITY_SIGNING_KID=organigrad-2026-09
# ⚠️  SECRET — fichier PEM PKCS8 de la clé privée Ed25519 d'OrganiGrad.
# Générer : openssl genpkey -algorithm ed25519 -out organigrad-identity.pem
# Publique : openssl pkey -in organigrad-identity.pem -pubout
ORGANIGRAD_IDENTITY_SIGNING_PRIVATE_KEY_FILE=/run/secrets/organigrad-identity.pem
# Base https du hub : POST {url}/api/identity-links/<propose|confirm|revoke>.
IDENTITY_LINKS_HUB_URL=https://api.synapse.nouvelleeredigital.fr

# ── Notifications Slack (webhooks entrants) ──────────────────────────────────
# ⚠️  SECRETS — toute personne possédant l'URL peut poster dans le canal.
# Canal #validations (ping HITL quand un nœud attend une validation humaine).
SLACK_VALIDATIONS=https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK
# Canal #flux-agents (journal des transitions).
SLACK_FLUX=https://hooks.slack.com/services/REPLACE/WITH/WEBHOOK

# ── Chiffrement des secrets d'intégration au repos (optionnel) ───────────────
# Clé AES-256 en base64 (32 octets). Générer : openssl rand -base64 32
# ⚠️  SECRET. Sans elle, le chiffrement des secrets d'intégration est indisponible.
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# ── Bus inter-applications Synapse (APPS-2026) ───────────────────────────────
# URL du bus ned-ia-synapse. http://synapse-backend:4400 en prod VPS, vide = désactivé.
# Émission best-effort (validation.requested / validation.approved / validation.rejected) :
# sans cette variable, l'orchestrateur fonctionne normalement, aucune émission réseau.
SYNAPSE_URL=

# ── Voice Gateway NED (proxy vocal, SDK @apps2026/voice-client) ──────────────
# URL du NED Voice Gateway (faster-whisper + Kokoro). Vide = proxy en 503,
# le reste de l'orchestrateur fonctionne normalement.
NED_VOICE_GATEWAY_URL=A_REMPLIR
# ⚠️  SECRET — jeton Bearer du gateway. Ne va JAMAIS au navigateur : la SPA ne
# parle qu'aux routes /api/voice/gateway/* de l'orchestrateur.
NED_VOICE_GATEWAY_TOKEN=A_REMPLIR

# ── Divers ───────────────────────────────────────────────────────────────────
# URL publique de la SPA (pour construire les liens dans les notifications).
APP_URL=https://app.example.com

# Allowlist CORS (origines séparées par des virgules ; jamais de wildcard *).
CORS_ALLOWED_ORIGINS=https://app.example.com

# ── SSRF (développement uniquement) ──────────────────────────────────────────
# La protection SSRF est STRICTE par défaut (https + IP publiques), quel que soit
# NODE_ENV. Pour viser un MCP local en dev, opt-in EXPLICITE (ne jamais activer
# en production) :
# SSRF_ALLOW_HTTP=1
# SSRF_ALLOW_PRIVATE=1
