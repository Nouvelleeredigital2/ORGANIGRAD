# ─── SPA Organigrad — template variables d'environnement ─────────────────────
# Copier en .env.local et remplir les valeurs.
# Supabase → https://supabase.com/dashboard/project/xucmfdggetwxmpquqjvj

VITE_SUPABASE_URL=https://xucmfdggetwxmpquqjvj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Navigation projets : activation coordonnée avec PROJECTS_ENABLED côté serveur
# et migration projets qualifiée. Aucun stockage de secours dans le navigateur.
VITE_PROJECTS_ENABLED=false

# Émission personnelle Synapse : opt-in distinct, avec backend qualifié/activé.
VITE_PRIVATE_PROJECTS_ENABLED=false

# URL HTTPS réelle de l'orchestrateur sur la cible qualifiée (À RENSEIGNER).
# Ne pas recopier une adresse de l'ancien VPS. Sans valeur, Accès Synapse est refusé.
# Le mode brouillon historique ne fournit aucun accès personnel de substitution.
VITE_ORCHESTRATOR_URL=
