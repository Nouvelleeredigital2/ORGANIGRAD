# E2E connectée (P0-5) — copier vers .env.connected, qui est gitignoré.
#
# ⚠️ Projet Supabase de TEST uniquement. Ces tests CRÉENT puis SUPPRIMENT des
# nœuds dans le workspace du compte indiqué. Ne jamais pointer la production.

# Projet Supabase de test (clé anon publique — pas la service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Compte de test, déjà créé et confirmé, membre d'au moins un workspace
# avec un rôle autorisant l'écriture (owner, admin ou member).
E2E_EMAIL=
E2E_PASSWORD=

# Facultatif : workspace à cibler. Laissé vide, le test prend le premier
# workspace dont le compte est membre.
E2E_WORKSPACE_ID=
