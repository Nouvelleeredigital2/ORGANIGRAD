# E2E connectée (P0-5, P1-7) — copier vers .env.connected, qui est gitignoré.
#
# ⚠️ Projet Supabase de TEST uniquement. Ces tests CRÉENT puis SUPPRIMENT des
# nœuds, des invitations et des clés API. Ne jamais pointer la production.

# Projet Supabase de test (clé anon publique — pas la service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Compte A ────────────────────────────────────────────────────────────────
# Déjà créé et confirmé, membre d'un workspace avec un rôle autorisant
# l'écriture (owner, admin ou member).
E2E_EMAIL=
E2E_PASSWORD=

# Facultatif : workspace à cibler. Laissé vide, le test prend le premier
# workspace dont le compte est membre.
E2E_WORKSPACE_ID=

# ── Compte B ────────────────────────────────────────────────────────────────
# INDISPENSABLE aux tests d'isolation : un second compte, membre d'un
# workspace DIFFÉRENT de celui du compte A, et non membre de celui de A.
# C'est précisément la configuration qu'exploitait la faille corrigée — elle
# ne se teste pas avec un seul compte.
# Sans ces variables, les tests d'isolation se sautent (les autres tournent).
E2E_EMAIL_B=
E2E_PASSWORD_B=
E2E_WORKSPACE_ID_B=

# ── Rôle en lecture seule (facultatif) ──────────────────────────────────────
# Compte `viewer` DANS LE WORKSPACE DU COMPTE A, pour vérifier qu'un lecteur
# n'obtient aucune commande d'administration. Sans lui, ces tests se sautent.
E2E_EMAIL_VIEWER=
E2E_PASSWORD_VIEWER=
